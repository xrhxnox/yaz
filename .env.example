# Nombres que aparecen en la app (A = tú, B = tu novia)
NEXT_PUBLIC_NOMBRE_A=Rick
NEXT_PUBLIC_NOMBRE_B=Yaz
NEXT_PUBLIC_FECHA_INICIO=2026-02-15

# Supabase > Project Settings: Data API (URL) y API Keys (Secret key sb_secret_… o legacy service_role)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Zona horaria que define cuándo cambia la pregunta y la foto del día
NEXT_PUBLIC_ZONA_HORARIA=America/Hermosillo

# Cuentas: cada quien entra con su correo y contraseña de Supabase Auth
# (Supabase > Authentication > Users). Solo estos dos correos tienen acceso.
CORREO_A=rick@ejemplo.com
CORREO_B=yaz@ejemplo.com

# Para iniciar sesión desde el navegador (son públicas, no son secretas)
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
